# Cloudflare Pages Headers
# Security Headers (Best Practices)
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googlesyndication.com https://*.googletagservices.com https://pagead2.googlesyndication.com https://*.googletagmanager.com https://*.google-analytics.com https://static.cloudflareinsights.com https://cdnjs.cloudflare.com https://*.highrevenueformat.com https://*.profitableratecpmnetwork.com https://*.effectivegatecpm.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https: blob:; connect-src 'self' https: wss:; frame-src 'self' https: blob: data: https://*.googlesyndication.com https://*.google.com https://googleads.g.doubleclick.net https://*.highrevenueformat.com https://*.profitableratecpmnetwork.com; object-src 'none'; base-uri 'self'; form-action 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Cache static assets for 1 year

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/manifest.json
  Cache-Control: public, max-age=86400

/*.html
  Cache-Control: public, max-age=0, s-maxage=86400, must-revalidate

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
  X-Robots-Tag: all

/sitemap-0.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
  X-Robots-Tag: all

/sitemap-index.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
  X-Robots-Tag: all

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
  X-Robots-Tag: all

/ad-*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store

/admin*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store

/404*
  X-Robots-Tag: noindex, follow
  Cache-Control: public, max-age=3600


