---
import { useTranslations } from "../utils/i18n";

interface Props {
    lang?: string;
    noindex?: boolean;
}

const { lang = "en", noindex = false } = Astro.props;
const t = useTranslations(lang);

const pathname = Astro.url.pathname.replace(/\.html$/, "");
const pathParts = pathname.split("/").filter(Boolean);
const siteOrigin = "https://savetik-fast.xyz";

// Identify language prefix
const isLangPrefix = lang !== "en" && pathParts.length > 0 && pathParts[0] === lang;
const breadcrumbParts = isLangPrefix ? pathParts.slice(1) : pathParts;
const pageSlug = breadcrumbParts[breadcrumbParts.length - 1] || "";

// Dynamically generate FAQ Schema matching specific page context
let faqPrefix = "faq";
if (pageSlug === "mp3") faqPrefix = "mp3_page.faq";
else if (pageSlug === "story") faqPrefix = "story_page.faq";
else if (pageSlug === "slideshow") faqPrefix = "slideshow_page.faq";
else if (["ios", "android", "mac", "pc"].includes(pageSlug)) faqPrefix = `${pageSlug}_page.faq`;

const faqSchemaItems = [];
let i = 1;
while (true) {
    let q = t(`${faqPrefix}.q${i}`);
    let a = t(`${faqPrefix}.a${i}`);

    // If page-specific prefix failed on the first question, try fallback to generic faq
    if ((!q || q === `${faqPrefix}.q${i}` || !a || a === `${faqPrefix}.a${i}`) && faqPrefix !== "faq" && i === 1) {
        faqPrefix = "faq";
        q = t(`faq.q${i}`);
        a = t(`faq.a${i}`);
    }

    // Stop if translation is missing (returns key) or empty
    if (!q || q === `${faqPrefix}.q${i}` || !a || a === `${faqPrefix}.a${i}`) {
        break;
    }

    faqSchemaItems.push({
        "@type": "Question",
        name: q,
        acceptedAnswer: {
            "@type": "Answer",
            text: a,
        },
    });
    i++;
}

const softwareAppSchema = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "SaveTikFast",
    url: "https://savetik-fast.xyz/",
    description: t("meta.description"),
    applicationCategory: "MultimediaApplication",
    operatingSystem: "All",
    browserRequirements: "Requires JavaScript",
    softwareVersion: "2026",
    offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
    },
    aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: "4.9",
        ratingCount: "18750",
        bestRating: "5",
        worstRating: "1",
    },
    author: {
        "@type": "Organization",
        name: "SaveTikFast",
    },
};

const websiteSchema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "SaveTikFast",
    "alternateName": ["SaveTik Fast", "Save Tik Fast", "TikTok Downloader"],
    "url": "https://savetik-fast.xyz/",
    "description": t("meta.description")
};

const organizationSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "SaveTikFast",
    url: "https://savetik-fast.xyz/",
    logo: "https://savetik-fast.xyz/og-image.png",
    sameAs: [],
    contactPoint: {
        "@type": "ContactPoint",
        email: "support@savetik-fast.xyz",
        contactType: "customer service",
        availableLanguage: [
            "English",
            "Arabic",
            "Spanish",
            "French",
            "German",
            "Portuguese",
            "Russian",
            "Chinese",
            "Japanese",
            "Korean",
        ],
    },
};

const itemListElement = [
    {
        "@type": "ListItem",
        position: 1,
        name: t("nav.home") || "Home",
        item: isLangPrefix ? `${siteOrigin}/${lang}` : `${siteOrigin}/`,
    },
];

let currentPath = isLangPrefix ? `/${lang}` : "";
breadcrumbParts.forEach((part, index) => {
    currentPath += `/${part}`;
    
    // Try to get translation if exists (e.g. nav.about -> About Us)
    let name = part.charAt(0).toUpperCase() + part.slice(1);
    const transName = t(`nav.${part}`);
    if (transName && transName !== `nav.${part}`) {
        name = transName;
    } else if (part === 'mp3') {
        name = "MP3";
    }

    itemListElement.push({
        "@type": "ListItem",
        position: index + 2,
        name: name,
        item: `${siteOrigin}${currentPath}`,
    });
});

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: itemListElement,
};
---

<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

{!noindex && (
<script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
)}

{
    !noindex && ["ios", "android", "mac", "pc"].includes(breadcrumbParts[breadcrumbParts.length - 1] || "") && (
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "SoftwareApplication",
                "name": `SaveTikFast for ${breadcrumbParts[breadcrumbParts.length - 1].toUpperCase()}`,
                "operatingSystem": breadcrumbParts[breadcrumbParts.length - 1].toUpperCase(),
                "applicationCategory": "MultimediaApplication",
                "offers": {
                    "@type": "Offer",
                    "price": "0",
                    "priceCurrency": "USD"
                },
                "aggregateRating": {
                    "@type": "AggregateRating",
                    "ratingValue": "4.8",
                    "ratingCount": "24890"
                }
            })}
        />
    )
}

{
    !noindex && faqSchemaItems.length > 0 && (
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "FAQPage",
                mainEntity: faqSchemaItems,
            })}
        />
    )
}

<script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
/>

<script
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema)}
/>
