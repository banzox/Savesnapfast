---
import { ADS_CONFIG } from "../config";
---

{ADS_CONFIG.enableAdsterra && (
<div class="native-ad-container" id="ad-container">
    <!-- الإعلان سيتم تحميله عند الظهور -->
</div>

<script>
    const loadNativeAd = () => {
        const container = document.getElementById('ad-container');
        if (!container) return;

        // Reset for ViewTransitions: wipe old content and flag
        container.innerHTML = '';
        delete container.dataset.loaded;
        container.dataset.loaded = 'true';

        // Container div MUST come before the script (Adsterra requirement)
        const adDiv = document.createElement('div');
        adDiv.id = 'container-2d1b844eacef7f58a020be44e8239ff9';
        container.appendChild(adDiv);

        const script = document.createElement('script');
        script.async = true;
        script.setAttribute('data-cfasync', 'false');
        script.src = 'https://ferocitycandour.com/2d1b844eacef7f58a020be44e8239ff9/invoke.js';
        container.appendChild(script);
    };

    const observeAd = () => {
        const container = document.getElementById('ad-container');
        if (!container) return;

        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
                if (entries[0].isIntersecting) {
                    loadNativeAd();
                    observer.disconnect();
                }
            }, { rootMargin: '200px' });
            observer.observe(container);
        } else {
            setTimeout(loadNativeAd, 3000);
        }
    };

    // Initial load
    observeAd();

    // Re-observe after every View Transition (resets loaded flag)
    document.addEventListener('astro:after-swap', observeAd);
</script>

<style>
    .native-ad-container {
        width: 100%;
        max-width: 1200px;
        margin: 40px auto;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 250px;
        overflow: hidden;
    }

    .native-ad-container :global(iframe) {
        max-width: 100% !important;
    }
</style>
)}
