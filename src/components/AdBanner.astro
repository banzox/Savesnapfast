<div class="ad-banner-grid">
    <!-- Native Ad Container -->
    <div class="native-ad-wrapper">
        <!-- Ad Script will be injected here dynamically -->
        <div id="container-2d1b844eacef7f58a020be44e8239ff9"></div>
    </div>
</div>

<script>
    // Lazy Load Native Ads to skyrocket Lighthouse Mobile Score
    const initAd = () => {
        if ((window as any).adLoaded) return;
        (window as any).adLoaded = true;

        const adScript = document.createElement("script");
        adScript.async = true;
        adScript.setAttribute("data-cfasync", "false");
        adScript.src = "https://pl28502654.effectivegatecpm.com/2d1b844eacef7f58a020be44e8239ff9/invoke.js";
        
        document.body.appendChild(adScript);
    };

    // Load ad on user interaction (scroll, click, touch) or after 3.5 seconds
    ["scroll", "mousemove", "touchstart", "click"].forEach((event) => {
        window.addEventListener(event, initAd, { once: true, passive: true });
    });
    
    setTimeout(initAd, 3500);
</script>

<style>
    .ad-banner-grid {
        display: flex;
        justify-content: center;
        width: 100%;
        max-width: 1200px;
        margin: 20px auto 40px;
        padding: 0 15px;
    }

    .native-ad-wrapper {
        width: 100%;
        min-height: 250px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    :global([data-theme="light"]) .native-ad-wrapper {
        background: rgba(0, 0, 0, 0.02);
        border-color: rgba(0, 0, 0, 0.05);
    }

    /* Support for internal responsive scaling */
    .native-ad-wrapper :global(div) {
        width: 100% !important;
        max-width: 100% !important;
    }

    @media (max-width: 768px) {
        .ad-banner-grid {
            margin: 15px auto 30px;
        }
    }
</style>
