---
import Layout from "../layouts/Layout.astro";
import { useTranslations } from "../utils/i18n";

interface Props {
    titleKey: string;
    contentKey: string;
    lang: string;
    noindex?: boolean;
}

const { titleKey, contentKey, lang, noindex = false } = Astro.props;
const t = useTranslations(lang);

const rawTitle = t(titleKey) || "SaveTikFast";
const pageTitle = rawTitle.includes("SaveTikFast")
    ? rawTitle
    : `${rawTitle} | SaveTikFast`;

const rawContent = t(contentKey) || "";

function escapeHtml(str: string): string {
    return str
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
}

// Format plain-text translations (that lack HTML block tags) into semantic paragraphs & headings
function formatRichHtml(input: string): string {
    if (!input) return "";
    if (/<(p|h2|h3|ul|ol|div)\b/i.test(input)) {
        return input;
    }
    const blocks = input
        .split(/\n{2,}/)
        .map((b) => b.trim())
        .filter(Boolean);

    return blocks
        .map((block) => {
            const lines = block.split("\n").map((l) => l.trim()).filter(Boolean);
            if (lines.length === 1 && lines[0].length < 80 && !/[.!?。！？]$/.test(lines[0])) {
                return `<h2>${escapeHtml(lines[0])}</h2>`;
            }
            if (lines.every((l) => /^[-•*]\s+/.test(l))) {
                const items = lines
                    .map((l) => `<li>${escapeHtml(l.replace(/^[-•*]\s+/, ""))}</li>`)
                    .join("");
                return `<ul>${items}</ul>`;
            }
            return `<p>${lines.map(escapeHtml).join("<br />")}</p>`;
        })
        .join("\n");
}

const formattedHtml = formatRichHtml(rawContent);
const plainText = rawContent.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
const autoDescription = plainText.length > 160
    ? plainText.substring(0, 157) + "..."
    : plainText;
const metaDescription = autoDescription || pageTitle;
---

<Layout
    title={pageTitle}
    description={metaDescription}
    lang={lang}
    noindex={noindex}
    pageType="page"
>
    <section class="page-header">
        <div class="container">
            <h1>{rawTitle}</h1>
        </div>
    </section>

    <section class="content-section">
        <div class="container">
            <article class="text-content">
                <Fragment set:html={formattedHtml} />
                <slot />
            </article>
        </div>
    </section>
</Layout>

<style>
    .page-header {
        background: var(--surface);
        padding: 3.5rem 1.25rem;
        text-align: center;
        border-bottom: 1px solid var(--border);
    }

    .page-header h1 {
        font-size: clamp(2rem, 4vw, 2.6rem);
        font-weight: 800;
        background: linear-gradient(
            135deg,
            var(--primary) 0%,
            var(--secondary) 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
    }

    .content-section {
        padding: 3.5rem 1.25rem;
    }

    .text-content {
        max-width: 820px;
        margin: 0 auto;
        font-size: 1.08rem;
        line-height: 1.8;
        color: var(--text-main);
        background: var(--glass);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: clamp(1.5rem, 4vw, 3rem);
    }

    :global([data-theme="light"]) .text-content {
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
    }

    .text-content :global(h2) {
        font-size: 1.55rem;
        margin-top: 2rem;
        margin-bottom: 0.85rem;
        color: var(--secondary);
    }

    .text-content :global(h2:first-child) {
        margin-top: 0;
    }

    .text-content :global(p) {
        margin-bottom: 1.25rem;
    }

    .text-content :global(ul) {
        margin-bottom: 1.5rem;
        padding-inline-start: 1.5rem;
    }

    .text-content :global(li) {
        margin-bottom: 0.5rem;
    }

    .text-content :global(a) {
        color: var(--secondary);
    }
</style>
