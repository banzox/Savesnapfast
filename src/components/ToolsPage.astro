---
import Layout from "../layouts/Layout.astro";
import ToolsTabs from "./tools/ToolsTabs.jsx";
import AdSenseSlot from "./AdSenseSlot.astro";
import FAQ from "./FAQ.astro";
import { useTranslations, getTranslations } from "../utils/i18n";
import { ADS_CONFIG } from "../config";

interface Props {
    lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translations = getTranslations(lang);

const prefixPath = (slug: string) => {
    if (lang === "en") return slug ? `/${slug}` : "/";
    return slug ? `/${lang}/${slug}` : `/${lang}`;
};

const safeT = (key: string, fallback: string) => {
    const val = t(key);
    return val && val !== key ? val : fallback;
};

const quickTools = [
    {
        id: "compressor",
        icon: "fas fa-compress-arrows-alt",
        name: safeT("tools.tabs.compressor", "Image Compressor"),
        desc: safeT("tools.compressor.desc", ""),
        tag: "WebP / PNG / JPG",
        color: "#00f2ea",
    },
    {
        id: "converter",
        icon: "fas fa-exchange-alt",
        name: safeT("tools.tabs.converter", "Image Converter"),
        desc: safeT("tools.converter.desc", ""),
        tag: "HTML5 Canvas",
        color: "#3b82f6",
    },
    {
        id: "qrcode",
        icon: "fas fa-qrcode",
        name: safeT("tools.tabs.qrcode", "QR Code Studio"),
        desc: safeT("tools.qrcode.desc", ""),
        tag: "1024px HD PNG",
        color: "#8b5cf6",
    },
    {
        id: "money",
        icon: "fas fa-coins",
        name: safeT("tools.tabs.money", "Earnings Calculator"),
        desc: safeT("tools.money.desc", ""),
        tag: "RPM / Views",
        color: "#10b981",
    },
    {
        id: "engagement",
        icon: "fas fa-chart-line",
        name: safeT("tools.tabs.engagement", "Engagement Calculator"),
        desc: safeT("tools.engagement.desc", ""),
        tag: "Analytics",
        color: "#f59e0b",
    },
    {
        id: "font",
        icon: "fas fa-font",
        name: safeT("tools.tabs.font", "Font Generator"),
        desc: safeT("tools.font.desc", ""),
        tag: "Unicode",
        color: "#ec4899",
    },
    {
        id: "hashtag",
        icon: "fas fa-hashtag",
        name: safeT("tools.tabs.hashtag", "Hashtag Generator"),
        desc: safeT("tools.hashtag.desc", ""),
        tag: "SEO / Bio",
        color: "#ff0050",
    },
];

const downloaders = [
    {
        icon: "fas fa-video",
        title: safeT("hero.title", "TikTok Video Downloader"),
        desc: safeT("hero.desc", ""),
        href: prefixPath(""),
    },
    {
        icon: "fas fa-headphones",
        title: safeT("mp3_page.title", "TikTok MP3"),
        desc: safeT("mp3_page.desc", ""),
        href: prefixPath("mp3"),
    },
    {
        icon: "fas fa-history",
        title: safeT("story_page.title", "TikTok Story Downloader"),
        desc: safeT("story_page.desc", ""),
        href: prefixPath("story"),
    },
    {
        icon: "fas fa-layer-group",
        title: safeT("slideshow_page.title", "TikTok Slideshow Downloader"),
        desc: safeT("slideshow_page.desc", ""),
        href: prefixPath("slideshow"),
    },
];

const toolsFaqItems = [
    { question: safeT("tools.compressor.faq.q1", ""), answer: safeT("tools.compressor.faq.a1", "") },
    { question: safeT("tools.compressor.faq.q2", ""), answer: safeT("tools.compressor.faq.a2", "") },
    { question: safeT("tools.converter.faq.q1", ""), answer: safeT("tools.converter.faq.a1", "") },
    { question: safeT("tools.converter.faq.q2", ""), answer: safeT("tools.converter.faq.a2", "") },
    { question: safeT("tools.qrcode.faq.q1", ""), answer: safeT("tools.qrcode.faq.a1", "") },
    { question: safeT("tools.qrcode.faq.q3", ""), answer: safeT("tools.qrcode.faq.a3", "") },
].filter((item) => item.question && item.answer);

const metaTitle = safeT("tools.meta.title", "Free Online Tools – SaveTikFast");
const metaDesc = safeT("tools.meta.description", safeT("tools.hero.desc", ""));
---

<Layout title={metaTitle} description={metaDesc} lang={lang} pageType="tool">
    <section class="tools-hero">
        <div class="tools-hero-inner">
            <div class="tools-status-badge">
                <span class="live-pulse"></span>
                <span>SaveTikFast • {safeT("nav.tools", "Tools")}</span>
            </div>

            <h1 class="tools-main-title">
                {safeT("tools.hero.title", "Free Online Creator & Media Tools")}
            </h1>

            <p class="tools-subtitle">
                {safeT("tools.hero.desc", "")}
            </p>

            <div class="tools-perks-row">
                <div class="perk-item">
                    <i class="fas fa-shield-alt"></i>
                    <span>{safeT("features.secure.title", "Private & Secure")}</span>
                </div>
                <div class="perk-item">
                    <i class="fas fa-bolt"></i>
                    <span>{safeT("features.fast.title", "Lightning Fast")}</span>
                </div>
                <div class="perk-item">
                    <i class="fas fa-infinity"></i>
                    <span>{safeT("features.free.title", "100% Free")}</span>
                </div>
            </div>
        </div>
    </section>

    <section class="tools-workspace-section">
        <div class="workspace-card">
            <ToolsTabs client:load translations={translations} />
        </div>
    </section>

    <div class="container">
        <AdSenseSlot slot={ADS_CONFIG.adsenseSlots.toolsBanner} />
    </div>

    <section class="container quick-tools-section">
        <div class="section-title-wrap">
            <span class="section-tag">SaveTikFast</span>
            <h2>{safeT("nav.tools", "Tools")}</h2>
            <p>{safeT("tools.hero.desc", "")}</p>
        </div>

        <div class="quick-tools-grid">
            {quickTools.map((tool) => (
                <a href={`#${tool.id}`} class="quick-tool-card" data-tool={tool.id}>
                    <div>
                        <div class="tool-card-top">
                            <div class="tool-icon-wrapper" style={`background: ${tool.color}18; color: ${tool.color}; border-color: ${tool.color}40;`}>
                                <i class={tool.icon}></i>
                            </div>
                            <span class="tool-tag">{tool.tag}</span>
                        </div>
                        <h3>{tool.name}</h3>
                        {tool.desc && <p class="tool-card-desc">{tool.desc}</p>}
                    </div>
                    <div class="tool-launch-link">
                        <span>{safeT("blog.try_now", "Try Now")}</span>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </a>
            ))}
        </div>
    </section>

    <script is:inline>
        (function () {
            function bindQuickTools() {
                const cards = document.querySelectorAll(".quick-tool-card");
                cards.forEach((card) => {
                    if (card.dataset.bound) return;
                    card.dataset.bound = "true";
                    card.addEventListener("click", (e) => {
                        e.preventDefault();
                        const toolId = card.getAttribute("data-tool");
                        if (toolId) {
                            window.dispatchEvent(new CustomEvent("switch-tool", { detail: { toolId } }));
                        }
                    });
                });
            }
            bindQuickTools();
            document.addEventListener("astro:page-load", bindQuickTools);
        })();
    </script>

    <!-- Rich Localized Documentation & Use-Cases for Search Indexing -->
    <section class="container seo-guides-grid">
        <article class="seo-guide-card">
            <h2>{safeT("tools.compressor.seo.title", "")}</h2>
            <p>{safeT("tools.compressor.seo.p1", "")}</p>
            <p>{safeT("tools.compressor.seo.p2", "")}</p>
            <ul>
                <li>{safeT("tools.compressor.seo.benefit1", "")}</li>
                <li>{safeT("tools.compressor.seo.benefit2", "")}</li>
                <li>{safeT("tools.compressor.seo.benefit3", "")}</li>
                <li>{safeT("tools.compressor.seo.benefit4", "")}</li>
            </ul>
            <p>{safeT("tools.compressor.seo.p3", "")}</p>
        </article>

        <article class="seo-guide-card">
            <h2>{safeT("tools.converter.seo.title", "")}</h2>
            <p>{safeT("tools.converter.seo.p1", "")}</p>
            <ul>
                <li><strong>WebP:</strong> {safeT("tools.converter.seo.webp", "")}</li>
                <li><strong>JPG:</strong> {safeT("tools.converter.seo.jpg", "")}</li>
                <li><strong>PNG:</strong> {safeT("tools.converter.seo.png", "")}</li>
            </ul>
            <p>{safeT("tools.converter.seo.p2", "")}</p>
        </article>

        <article class="seo-guide-card">
            <h2>{safeT("tools.qrcode.seo.title", "")}</h2>
            <p>{safeT("tools.qrcode.seo.p1", "")}</p>
            <ul>
                <li>{safeT("tools.qrcode.seo.use1", "")}</li>
                <li>{safeT("tools.qrcode.seo.use2", "")}</li>
                <li>{safeT("tools.qrcode.seo.use3", "")}</li>
                <li>{safeT("tools.qrcode.seo.use4", "")}</li>
            </ul>
            <p>{safeT("tools.qrcode.seo.p2", "")}</p>
        </article>
    </section>

    {toolsFaqItems.length > 0 && <FAQ t={t} items={toolsFaqItems} />}

    <section class="container downloaders-section">
        <div class="section-title-wrap">
            <span class="section-tag">SaveTikFast</span>
            <h2>{safeT("blog.tools_heading", safeT("hero.title", "TikTok Downloader"))}</h2>
        </div>

        <div class="downloaders-grid">
            {downloaders.map((d) => (
                <a href={d.href} class="downloader-nav-card">
                    <div class="d-icon-box">
                        <i class={d.icon}></i>
                    </div>
                    <div class="d-text-content">
                        <h3>{d.title}</h3>
                        <p>{d.desc}</p>
                    </div>
                    <div class="d-arrow-btn">
                        <i class="fas fa-chevron-right"></i>
                    </div>
                </a>
            ))}
        </div>
    </section>
</Layout>

<style>
    .tools-hero {
        padding: 50px 20px 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .tools-hero-inner {
        max-width: 860px;
        margin: 0 auto;
    }
    .tools-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(0, 242, 234, 0.1);
        border: 1px solid rgba(0, 242, 234, 0.3);
        color: #00f2ea;
        padding: 6px 16px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 20px;
    }
    :global([data-theme="light"]) .tools-status-badge {
        background: rgba(37, 99, 235, 0.08);
        border-color: rgba(37, 99, 235, 0.25);
        color: #2563eb;
    }
    .live-pulse {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 10px #10b981;
    }
    .tools-main-title {
        font-size: clamp(2rem, 4vw, 2.7rem);
        font-weight: 900;
        line-height: 1.2;
        color: var(--text-main, #ffffff);
        margin: 0 0 16px;
        letter-spacing: -0.5px;
    }
    .tools-subtitle {
        font-size: 1.08rem;
        color: var(--text-dim);
        line-height: 1.65;
        max-width: 720px;
        margin: 0 auto 26px;
    }
    .tools-perks-row {
        display: flex;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
    }
    .perk-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text-dim);
        background: rgba(255, 255, 255, 0.04);
        padding: 6px 14px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
    :global([data-theme="light"]) .perk-item {
        background: #f1f5f9;
        border-color: rgba(0, 0, 0, 0.08);
        color: #475569;
    }
    .perk-item i {
        color: var(--secondary);
    }

    .tools-workspace-section {
        max-width: 1060px;
        margin: 0 auto 45px;
        padding: 0 20px;
    }
    .workspace-card {
        background: rgba(18, 18, 38, 0.72);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 28px;
        padding: 25px 20px 35px;
        backdrop-filter: blur(24px);
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.45);
    }
    :global([data-theme="light"]) .workspace-card {
        background: #ffffff;
        border-color: rgba(0, 0, 0, 0.08);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.06);
    }

    .section-title-wrap {
        text-align: center;
        margin-bottom: 32px;
    }
    .section-tag {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--primary);
        margin-bottom: 8px;
    }
    .section-title-wrap h2 {
        font-size: 1.9rem;
        font-weight: 800;
        color: var(--text-main);
        margin: 0 0 10px;
    }
    .section-title-wrap p {
        color: var(--text-dim);
        font-size: 0.98rem;
        max-width: 620px;
        margin: 0 auto;
    }

    .quick-tools-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 50px;
    }
    .quick-tool-card {
        background: var(--glass);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 22px;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 14px;
        transition: transform 0.25s ease, border-color 0.25s ease;
    }
    :global([data-theme="light"]) .quick-tool-card {
        background: #ffffff;
    }
    .quick-tool-card:hover {
        transform: translateY(-4px);
        border-color: var(--secondary);
    }
    .tool-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }
    .tool-icon-wrapper {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        border: 1px solid;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
    .tool-tag {
        font-size: 0.72rem;
        font-weight: 700;
        background: rgba(255, 255, 255, 0.06);
        color: var(--text-dim);
        padding: 4px 10px;
        border-radius: 12px;
    }
    :global([data-theme="light"]) .tool-tag {
        background: #f1f5f9;
        color: #64748b;
    }
    .quick-tool-card h3 {
        font-size: 1.12rem;
        font-weight: 700;
        color: var(--text-main);
        margin: 0 0 8px;
    }
    .tool-card-desc {
        font-size: 0.88rem;
        color: var(--text-dim);
        line-height: 1.5;
        margin: 0;
    }
    .tool-launch-link {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.86rem;
        font-weight: 700;
        color: var(--secondary);
    }

    .seo-guides-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
        gap: 22px;
        margin: 20px auto 45px;
    }
    .seo-guide-card {
        background: var(--glass);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 26px;
        line-height: 1.7;
    }
    :global([data-theme="light"]) .seo-guide-card {
        background: #ffffff;
    }
    .seo-guide-card h2 {
        font-size: 1.3rem;
        color: var(--text-main);
        margin: 0 0 12px;
    }
    .seo-guide-card p {
        font-size: 0.94rem;
        color: var(--text-dim);
        margin: 0 0 12px;
    }
    .seo-guide-card ul {
        padding-inline-start: 1.25rem;
        margin: 0 0 12px;
        color: var(--text-dim);
        font-size: 0.92rem;
    }
    .seo-guide-card li {
        margin-bottom: 6px;
    }

    .downloaders-section {
        margin-top: 3rem;
    }
    .downloaders-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 18px;
        margin-bottom: 65px;
    }
    .downloader-nav-card {
        background: var(--glass);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 20px;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: all 0.25s ease;
    }
    :global([data-theme="light"]) .downloader-nav-card {
        background: #ffffff;
    }
    .downloader-nav-card:hover {
        border-color: var(--primary);
        transform: translateY(-3px);
    }
    .d-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(255, 0, 80, 0.12);
        color: #ff0050;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }
    .d-text-content {
        flex: 1;
    }
    .d-text-content h3 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-main);
        margin: 0 0 4px;
    }
    .d-text-content p {
        font-size: 0.84rem;
        color: var(--text-dim);
        margin: 0;
        line-height: 1.45;
    }
    .d-arrow-btn {
        color: var(--text-dim);
        font-size: 0.9rem;
    }
</style>
