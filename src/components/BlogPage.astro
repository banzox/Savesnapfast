---
import Layout from "../layouts/Layout.astro";
import AdSenseSlot from "./AdSenseSlot.astro";
import { useTranslations } from "../utils/i18n";
import { getCollection } from "astro:content";
import { ADS_CONFIG } from "../config";

interface Props {
    lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allPosts = await getCollection("blog", ({ data }) => {
    return data.lang === lang;
});

const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatPostDate(date: Date, locale: string): string {
    const intlLocale = locale === "fil" ? "fil-PH" : locale === "no" ? "nb-NO" : locale;
    try {
        return new Intl.DateTimeFormat(intlLocale, {
            year: "numeric",
            month: "short",
            day: "numeric",
        }).format(date);
    } catch {
        return date.toISOString().slice(0, 10);
    }
}

const guideSections = [1, 2, 3, 4, 5]
    .map((n) => {
        const titleKey = `blog.section${n}_title`;
        const contentKey = `blog.section${n}_content`;
        const title = t(titleKey);
        const content = t(contentKey);
        return {
            title: title !== titleKey ? title : "",
            content: content !== contentKey ? content : "",
        };
    })
    .filter((sec) => sec.title && sec.content);

const downloadCards = [
    {
        id: "video",
        icon: "fas fa-video",
        color: "linear-gradient(135deg, #ff0050 0%, #ff2d78 100%)",
        href: lang === "en" ? "/" : `/${lang}`,
    },
    {
        id: "mp3",
        icon: "fas fa-music",
        color: "linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)",
        href: lang === "en" ? "/mp3" : `/${lang}/mp3`,
    },
    {
        id: "slideshow",
        icon: "fas fa-layer-group",
        color: "linear-gradient(135deg, #667eea 0%, #764ba2 100%)",
        href: lang === "en" ? "/slideshow" : `/${lang}/slideshow`,
    },
    {
        id: "story",
        icon: "fas fa-images",
        color: "linear-gradient(135deg, #f093fb 0%, #f5576c 100%)",
        href: lang === "en" ? "/story" : `/${lang}/story`,
    },
];

const homeHref = lang === "en" ? "/" : `/${lang}`;
---

<Layout
    title={t("blog.meta_title")}
    description={t("blog.meta_desc")}
    lang={lang}
    pageType="tool"
>
    <div class="blog-container">
        <section class="blog-hero">
            <a href={homeHref} class="back-home">
                <i class="fas fa-arrow-left"></i>
                {t("blog.back_home")}
            </a>
            <h1 class="blog-title">
                <i class="fas fa-blog"></i>
                {t("blog.title")}
            </h1>
            <p class="blog-subtitle">{t("blog.subtitle")}</p>
            <p class="blog-date">
                <i class="fas fa-calendar-alt"></i>
                {t("blog.updated")} 2026
            </p>
        </section>

        <section class="posts-section">
            <h2 class="section-heading">{t("blog.latest_posts") || "Latest Articles"}</h2>
            <div class="posts-grid">
                {
                    posts.map((post) => (
                        <article class="post-card">
                            {post.data.cover && (
                                <div class="post-card-image">
                                    <img src={post.data.cover} alt={post.data.title} loading="lazy" />
                                </div>
                            )}
                            <div class="post-card-content">
                                <div class="post-card-meta">
                                    <i class="fas fa-calendar-alt"></i>
                                    <time datetime={post.data.pubDate.toISOString()}>
                                        {formatPostDate(post.data.pubDate, lang)}
                                    </time>
                                </div>
                                <h3>
                                    <a
                                        href={lang === "en" ? `/blog/${post.slug}` : `/${lang}/blog/${post.slug}`}
                                        class="post-title-link"
                                    >
                                        {post.data.title}
                                    </a>
                                </h3>
                                <p>{post.data.description}</p>
                                <a
                                    href={lang === "en" ? `/blog/${post.slug}` : `/${lang}/blog/${post.slug}`}
                                    class="read-more"
                                >
                                    {t("blog.read_more") || "Read More"} <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <AdSenseSlot slot={ADS_CONFIG.adsenseSlots.midContent} />

        {/* Comprehensive Localized Pillar Guide Sections */}
        {guideSections.length > 0 && (
            <section class="pillar-guide-section">
                {guideSections.map((sec) => (
                    <article class="pillar-guide-card">
                        <h2>{sec.title}</h2>
                        <div class="pillar-guide-body">
                            <Fragment set:html={sec.content} />
                        </div>
                    </article>
                ))}
            </section>
        )}

        <section class="cards-section">
            <h2 class="section-heading">{t("blog.tools_heading")}</h2>
            <div class="cards-grid">
                {
                    downloadCards.map((card) => (
                        <a
                            href={card.href}
                            class="download-card"
                            style={`--card-gradient: ${card.color}`}
                        >
                            <div class="card-icon">
                                <i class={card.icon} />
                            </div>
                            <h3>{t(`blog.card_${card.id}_title`)}</h3>
                            <p>{t(`blog.card_${card.id}_desc`)}</p>
                            <span class="card-cta">
                                {t("blog.try_now")}{" "}
                                <i class="fas fa-chevron-right" />
                            </span>
                        </a>
                    ))
                }
            </div>
        </section>

        <section class="cta-section">
            <h2>{t("blog.cta_title")}</h2>
            <p>{t("blog.cta_desc")}</p>
            <a href={homeHref} class="cta-btn">
                <i class="fas fa-download"></i>
                {t("blog.cta_button")}
            </a>
        </section>
    </div>
</Layout>

<style>
    .blog-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .blog-hero {
        text-align: center;
        padding: 3rem 1rem;
        position: relative;
    }

    .back-home {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-dim);
        text-decoration: none;
        font-size: 0.95rem;
        margin-bottom: 2rem;
        padding: 10px 20px;
        border-radius: 25px;
        background: var(--glass);
        border: 1px solid var(--border);
        transition: all 0.3s ease;
    }

    .back-home:hover {
        color: var(--secondary);
        border-color: var(--secondary);
        transform: translateX(-5px);
    }

    .blog-title {
        font-size: clamp(1.9rem, 4vw, 2.5rem);
        font-weight: 800;
        margin-bottom: 1rem;
        background: linear-gradient(
            135deg,
            var(--primary) 0%,
            var(--secondary) 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .blog-title i {
        margin-inline-end: 10px;
    }

    .blog-subtitle {
        font-size: 1.15rem;
        color: var(--text-dim);
        max-width: 720px;
        margin: 0 auto 1rem;
        line-height: 1.7;
    }

    .blog-date {
        color: var(--text-dim);
        font-size: 0.9rem;
        opacity: 0.85;
    }

    .blog-date i {
        margin-inline-end: 6px;
        color: var(--secondary);
    }

    .cards-section {
        margin: 3.5rem 0;
    }

    .section-heading {
        text-align: center;
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 2rem;
        color: var(--text-main);
    }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 25px;
    }

    .download-card {
        background: var(--glass);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 30px;
        text-decoration: none;
        color: var(--text-main);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .download-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: var(--card-gradient);
    }

    .download-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        border-color: var(--border-bright);
    }

    .card-icon {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        background: var(--card-gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: white;
        margin-bottom: 18px;
    }

    .download-card h3 {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .download-card p {
        color: var(--text-dim);
        font-size: 0.94rem;
        line-height: 1.6;
        margin-bottom: 15px;
    }

    .card-cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--secondary);
        font-weight: 600;
        font-size: 0.9rem;
    }

    .posts-section {
        margin: 2.5rem 0 3.5rem;
    }

    .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
        gap: 28px;
    }

    .post-card {
        background: var(--glass);
        border: 1px solid var(--border);
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    .post-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        border-color: var(--secondary);
    }

    .post-card-image {
        height: 200px;
        overflow: hidden;
    }

    .post-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .post-card:hover .post-card-image img {
        transform: scale(1.06);
    }

    .post-card-content {
        padding: 24px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .post-card-meta {
        font-size: 0.85rem;
        color: var(--text-dim);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .post-card-meta i {
        color: var(--secondary);
    }

    .post-card h3 {
        font-size: 1.32rem;
        font-weight: 700;
        margin-bottom: 12px;
        line-height: 1.35;
    }

    .post-title-link {
        color: var(--text-main);
        text-decoration: none;
    }

    .post-title-link:hover {
        color: var(--secondary);
    }

    .post-card p {
        color: var(--text-dim);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 20px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .read-more {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--secondary);
        font-weight: 700;
        text-decoration: none;
        font-size: 0.95rem;
    }

    .pillar-guide-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 24px;
        margin: 2.5rem 0 3.5rem;
    }

    .pillar-guide-card {
        background: var(--glass);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 28px;
        line-height: 1.75;
    }

    :global([data-theme="light"]) .pillar-guide-card {
        background: #ffffff;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
    }

    .pillar-guide-card h2 {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--text-main);
        margin: 0 0 14px;
    }

    .pillar-guide-body {
        color: var(--text-dim);
        font-size: 0.96rem;
    }

    .pillar-guide-body :global(strong) {
        color: var(--text-main);
    }

    .cta-section {
        text-align: center;
        padding: 55px 30px;
        background: linear-gradient(
            135deg,
            var(--glass) 0%,
            rgba(255, 0, 80, 0.05) 100%
        );
        border-radius: 20px;
        border: 1px solid var(--border);
        margin-bottom: 4rem;
    }

    .cta-section h2 {
        font-size: 1.9rem;
        font-weight: 800;
        margin-bottom: 14px;
    }

    .cta-section p {
        color: var(--text-dim);
        margin-bottom: 24px;
        font-size: 1.05rem;
    }

    .cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 15px 38px;
        background: linear-gradient(
            135deg,
            var(--primary) 0%,
            var(--secondary) 100%
        );
        color: white;
        text-decoration: none;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1.05rem;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px var(--primary-glow);
    }

    :global([data-theme="light"]) .download-card,
    :global([data-theme="light"]) .post-card {
        background: #ffffff;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    :global([data-theme="light"]) .cta-section {
        background: linear-gradient(
            135deg,
            #ffffff 0%,
            rgba(37, 99, 235, 0.03) 100%
        );
    }
</style>
