---
import Layout from "../layouts/Layout.astro";
import Downloader from "./Downloader.jsx";
import FAQ from "./FAQ.astro";
import AdSenseSlot from "./AdSenseSlot.astro";
import { getTranslations, useTranslations } from "../utils/i18n";
import { ADS_CONFIG } from "../config";

interface Props {
    lang: string;
    pagePrefix: string;
    mode?: "video" | "mp3" | "story" | "slideshow" | undefined;
    showAd?: boolean;
    noindex?: boolean;
}

const { lang, pagePrefix, mode, showAd = true, noindex = false } = Astro.props;
const enableAdsterra = showAd && ADS_CONFIG.enableAdsterra;
const enableAdSense = !noindex && ADS_CONFIG.enableAdSense;
const t = useTranslations(lang);
const translations = getTranslations(lang);

// --- Helper to build keys ---
const getKey = (suffix: string) =>
    pagePrefix ? `${pagePrefix}.${suffix}` : suffix;

// --- Smart FAQ Loop ---
const faqItems = [];
let i = 1;
while (true) {
    const qKey = getKey(`faq.q${i}`);
    const aKey = getKey(`faq.a${i}`);
    const q = t(qKey);
    const a = t(aKey);

    if (!q || q === qKey || !a || a === aKey) {
        break;
    }

    faqItems.push({ question: q, answer: a });
    i++;
}

// --- Dynamic Features Generation (supports all page-specific and core feature keys) ---
const featureKeys = [
    "all",
    "no_watermark",
    "nowatermark",
    "fast",
    "quality",
    "audio",
    "ringtone",
    "original",
    "expire",
    "anonymous",
    "device",
    "free",
    "unlimited",
    "secure",
    "safe",
    "browser",
    "noapp",
    "nobapp",
    "batch",
    "slides",
    "favorites",
    "trending",
    "bulk",
    "format",
];

const ICON_MAP: Record<string, string> = {
    all: "fas fa-images",
    no_watermark: "fas fa-magic",
    nowatermark: "fas fa-magic",
    fast: "fas fa-bolt",
    quality: "fas fa-film",
    audio: "fas fa-music",
    ringtone: "fas fa-bell",
    original: "fas fa-check-circle",
    expire: "fas fa-clock",
    anonymous: "fas fa-user-secret",
    device: "fas fa-mobile-alt",
    free: "fas fa-infinity",
    unlimited: "fas fa-infinity",
    secure: "fas fa-shield-alt",
    safe: "fas fa-shield-alt",
    browser: "fas fa-globe",
    noapp: "fas fa-laptop-code",
    nobapp: "fas fa-laptop-code",
    batch: "fas fa-layer-group",
    slides: "fas fa-layer-group",
    favorites: "fas fa-heart",
    trending: "fas fa-fire",
    bulk: "fas fa-images",
    format: "fas fa-file-image",
};

const features = [];
const seenFeatureTitles = new Set<string>();

for (const key of featureKeys) {
    let titleKey = getKey(`features.${key}.title`);
    let descKey = getKey(`features.${key}.desc`);
    let title = t(titleKey);
    let desc = t(descKey);

    // Fallback to core features only when no page-specific equivalent was already added
    if ((!title || title === titleKey) && pagePrefix) {
        titleKey = `features.${key}.title`;
        descKey = `features.${key}.desc`;
        title = t(titleKey);
        desc = t(descKey);
    }

    if (title && title !== titleKey && desc && desc !== descKey && !seenFeatureTitles.has(title)) {
        seenFeatureTitles.add(title);
        features.push({
            icon: ICON_MAP[key] || "fas fa-star",
            title,
            desc,
        });
    }
    if (features.length >= 8) break;
}

// --- How-To Section ---
const howToSteps = [];
let s = 1;
while (true) {
    let titleKey = getKey(`how_to.step${s}_title`);
    let descKey = getKey(`how_to.step${s}`);
    let desc = t(descKey);

    if (!desc || desc === descKey) {
        if (pagePrefix && s <= 3) {
            titleKey = `how_to.step${s}_title`;
            descKey = `how_to.step${s}`;
            desc = t(descKey);
        }
        if (!desc || desc === descKey) break;
    }

    const rawStepTitle = t(titleKey);
    const stepTitle = rawStepTitle && rawStepTitle !== titleKey ? rawStepTitle : `${s}`;
    howToSteps.push({ title: stepTitle, desc });
    s++;
}

const showHowTo = howToSteps.length > 0;
let howToTitle = t(getKey("how_to.title"));
if (!howToTitle || howToTitle === getKey("how_to.title")) {
    howToTitle = t("how_to.title");
}

// --- About Section ---
const aboutTitleKey = getKey("about_title");
const aboutTitle = t(aboutTitleKey);
const aboutContent = t(getKey("about_content"));
const showAbout = aboutTitle && aboutTitle !== aboutTitleKey;
let aboutIcon = "fas fa-info-circle";
if (pagePrefix.includes("mp3")) aboutIcon = "fas fa-headphones";
if (pagePrefix.includes("story")) aboutIcon = "fas fa-photo-film";
if (pagePrefix.includes("slideshow")) aboutIcon = "fas fa-layer-group";

// --- Meta Data ---
const pageMetaTitleKey = getKey("meta_title");
const pageMetaDescKey = getKey("meta_desc");
const pageMetaTitle = t(pageMetaTitleKey);
const pageMetaDesc = t(pageMetaDescKey);

const metaTitle =
    pageMetaTitle !== pageMetaTitleKey ? pageMetaTitle : t("meta.title");
const metaDesc =
    pageMetaDesc !== pageMetaDescKey ? pageMetaDesc : t("meta.description");

// --- Hero ---
let heroTitleDesc = "";
let heroDesc = "";
let heroOnColor = "";

if (!pagePrefix) {
    heroTitleDesc = t("hero.title");
    heroDesc = t("hero.desc");
    heroOnColor = t("downloader.hd_quality");
} else {
    heroTitleDesc = t(`${pagePrefix}.title`);
    heroDesc = t(`${pagePrefix}.desc`);
    if (pagePrefix === "mp3_page") heroOnColor = t(`${pagePrefix}.subtitle`);
}

const badgeLabel = `SaveTikFast • ${t("downloader.hd_quality")}`;
---

<Layout title={metaTitle} description={metaDesc} lang={lang} noindex={noindex} pageType="tool">
    <div class="main-wrapper">
        <article class="hero-section">
            <div class="hero-live-badge">
                <span class="live-pulse"></span>
                <span>⚡ {badgeLabel}</span>
            </div>

            <h1 class="hero-title">
                {
                    pagePrefix === "mp3_page" ? (
                        <span>
                            <i class="fas fa-music accent-text" />{" "}
                            {heroTitleDesc}{" "}
                            <span class="accent-text">{heroOnColor}</span>
                        </span>
                    ) : pagePrefix === "story_page" ? (
                        <span>
                            <i class="fas fa-images accent-text" />{" "}
                            {heroTitleDesc}
                        </span>
                    ) : pagePrefix === "slideshow_page" ? (
                        <span>
                            <i class="fas fa-layer-group accent-text" />{" "}
                            {heroTitleDesc}
                        </span>
                    ) : pagePrefix === "ios_page" ? (
                        <span>
                            <i class="fab fa-apple accent-text" />{" "}
                            {heroTitleDesc}
                        </span>
                    ) : pagePrefix === "android_page" ? (
                        <span>
                            <i class="fab fa-android accent-text" />{" "}
                            {heroTitleDesc}
                        </span>
                    ) : pagePrefix === "mac_page" ? (
                        <span>
                            <i class="fas fa-laptop accent-text" />{" "}
                            {heroTitleDesc}
                        </span>
                    ) : pagePrefix === "pc_page" ? (
                        <span>
                            <i class="fas fa-desktop accent-text" />{" "}
                            {heroTitleDesc}
                        </span>
                    ) : (
                        <span>
                            {t("hero.title")}{" "}
                            <span class="accent-text">
                                ({t("downloader.hd_quality")})
                            </span>
                        </span>
                    )
                }
            </h1>
            <p class="hero-desc">
                {heroDesc}
            </p>

            <div class="downloader-wrapper">
                <Downloader
                    client:load
                    messages={translations.downloader}
                    mode={mode}
                    placeholder={pagePrefix
                        ? t(`${pagePrefix}.placeholder`)
                        : t("downloader.placeholder")}
                />
            </div>
        </article>

        {enableAdSense && (
            <div class="container">
                <AdSenseSlot slot={ADS_CONFIG.adsenseSlots.heroBottom} />
            </div>
        )}

        {enableAdsterra && (
            <div class="ad-slot ad-slot-top">
                <script is:inline async="async" data-cfasync="false" src="https://pl28502654.profitableratecpmnetwork.com/2d1b844eacef7f58a020be44e8239ff9/invoke.js"></script>
                <div id="container-2d1b844eacef7f58a020be44e8239ff9"></div>
            </div>
        )}
    </div>

    <section class="container features-grid" aria-label={t("features.title") || "Features"}>
        {
            features.map((feature) => (
                <div class="feature-card">
                    <i class={feature.icon} />
                    <h3>{feature.title}</h3>
                    <p>{feature.desc}</p>
                </div>
            ))
        }
    </section>

    {
        showHowTo && (
            <section class="container how-to-box shadow-box" aria-labelledby="how-to-title">
                <h2 id="how-to-title" class="section-title">{howToTitle}</h2>
                <div class="steps-wrapper">
                    {howToSteps.map((step, index) => (
                        <div class="step">
                            <div class="step-num">{index + 1}</div>
                            <h3>{step.title}</h3>
                            <p>{step.desc}</p>
                        </div>
                    ))}
                </div>
            </section>
        )
    }

    {
        showAbout && (
            <section class="container shadow-box about-section" aria-labelledby="about-title">
                <div class="content-box">
                    <h2 id="about-title">
                        <i class={`${aboutIcon} accent-text`} /> {aboutTitle}
                    </h2>
                    <p>{aboutContent}</p>
                </div>
            </section>
        )
    }

    {enableAdSense && (
        <div class="container">
            <AdSenseSlot slot={ADS_CONFIG.adsenseSlots.midContent} />
        </div>
    )}

    {faqItems.length > 0 && (
        <section class="container" style="margin-top: 20px;">
            <div class="toc-container">
                <div class="toc-header">
                    <i class="fas fa-list-ul"></i>
                    <h2 style="margin: 0; font-size: 1.2rem; color: var(--text-main);">{t("blog.toc_title") || "FAQ"}</h2>
                </div>
                <ul class="toc-list" style="list-style: none; padding: 0; margin: 0;">
                    {faqItems.map((item, idx) => (
                        <li class="toc-item" style="margin-bottom: 10px;">
                            <a href={`#faq-${idx + 1}`} style="color: var(--text-dim); text-decoration: none; transition: color 0.2s;">
                                {item.question}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </section>
    )}

    <FAQ t={t} items={faqItems} />

    {["ios_page", "android_page", "mac_page", "pc_page"].includes(pagePrefix) && (
        <section class="container shadow-box about-section" aria-labelledby="device-guide-title">
            <div class="content-box">
                <h2 id="device-guide-title">
                    <i class={pagePrefix === "ios_page" ? "fab fa-apple accent-text" : pagePrefix === "android_page" ? "fab fa-android accent-text" : pagePrefix === "mac_page" ? "fas fa-laptop accent-text" : "fas fa-desktop accent-text"} />{" "}
                    {t(`${pagePrefix}.guide_title`) !== `${pagePrefix}.guide_title` ? t(`${pagePrefix}.guide_title`) : heroTitleDesc}
                </h2>
                <p class="intro">{heroDesc}</p>
                <div class="device-tips" style="margin-top: 1.25rem; line-height: 1.8; color: var(--text-dim);">
                    <p>{t(`${pagePrefix}.guide_tip`)}</p>
                </div>
            </div>
        </section>
    )}

    {!pagePrefix && t("seo_rich_content.intro_title") !== "seo_rich_content.intro_title" && (
        <section class="container shadow-box seo-content-section" style="margin-top: 3rem;">
            <h2 class="section-title">{t("seo_rich_content.intro_title")}</h2>
            <p>{t("seo_rich_content.intro_p1")}</p>
            <p>{t("seo_rich_content.intro_p2")}</p>

            <h2 class="section-title">{t("seo_rich_content.why_title")}</h2>
            <p>{t("seo_rich_content.why_p1")}</p>
            <p>{t("seo_rich_content.why_p2")}</p>
            <p>{t("seo_rich_content.why_p3")}</p>

            <h2 class="section-title">{t("seo_rich_content.guide_title")}</h2>
            <p>{t("seo_rich_content.guide_p1")}</p>

            <h2 class="section-title">{t("seo_rich_content.comparison_title")}</h2>
            <p>{t("seo_rich_content.comparison_p1")}</p>

            <h2 class="section-title">{t("seo_rich_content.tips_title")}</h2>
            <p>{t("seo_rich_content.tips_p1")}</p>

            <h2 class="section-title">{t("seo_rich_content.conclusion_title")}</h2>
            <p>{t("seo_rich_content.conclusion_p1")}</p>
        </section>
    )}
</Layout>

<style>
    .hero-section {
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.5rem 1rem 0.5rem;
    }

    .hero-title {
        font-size: clamp(1.25rem, 2.8vw, 1.9rem);
        font-weight: 800;
        margin-bottom: 0.5rem;
        line-height: 1.3;
        letter-spacing: -0.5px;
    }

    .hero-desc {
        font-size: clamp(0.9rem, 1.6vw, 1.05rem);
        margin-bottom: 1.25rem;
        max-width: 40rem;
        margin-left: auto;
        margin-right: auto;
        color: var(--text-dim);
        line-height: 1.55;
    }

    .accent-text {
        color: var(--secondary);
    }

    :global([data-theme="light"]) .accent-text {
        color: var(--primary);
    }

    .downloader-wrapper {
        width: 100%;
        max-width: 48rem;
        margin-left: auto;
        margin-right: auto;
    }

    .steps-wrapper {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 25px;
        margin-top: 30px;
    }

    .step {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 28px 24px;
        position: relative;
        overflow: hidden;
        transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s ease, border-color 0.35s ease;
    }

    :global([data-theme="light"]) .step {
        background: #ffffff;
        border-color: rgba(0, 0, 0, 0.08);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    }

    .step:hover {
        transform: translateY(-5px);
        box-shadow: 0 16px 35px rgba(0, 0, 0, 0.2);
        border-color: var(--secondary);
    }

    :global([data-theme="light"]) .step:hover {
        border-color: var(--primary);
        box-shadow: 0 12px 30px rgba(37, 99, 235, 0.1);
    }

    .step-num {
        font-size: 3.5rem;
        font-weight: 900;
        color: rgba(255, 255, 255, 0.04);
        position: absolute;
        top: 10px;
        right: 18px;
        line-height: 1;
        pointer-events: none;
    }

    :global([data-theme="light"]) .step-num {
        color: rgba(0, 0, 0, 0.04);
    }

    .step h3 {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 10px;
        position: relative;
        z-index: 1;
    }

    .step p {
        font-size: 0.92rem;
        line-height: 1.6;
        color: var(--text-dim);
        position: relative;
        z-index: 1;
    }

    .section-title {
        text-align: center;
        margin-bottom: 30px;
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--text-main);
        letter-spacing: -0.5px;
    }

    .about-section {
        margin-top: 3rem;
        padding: 35px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 20px;
    }

    :global([data-theme="light"]) .about-section {
        background: #ffffff;
        border-color: rgba(0, 0, 0, 0.06);
    }

    .seo-content-section {
        padding: 35px 30px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 20px;
        margin-bottom: 2rem;
    }

    :global([data-theme="light"]) .seo-content-section {
        background: #ffffff;
        border-color: rgba(0, 0, 0, 0.06);
    }

    .seo-content-section h2 {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-main);
        margin-top: 1.8rem;
        margin-bottom: 0.8rem;
    }

    .seo-content-section h2:first-child {
        margin-top: 0;
    }

    .seo-content-section p {
        font-size: 0.95rem;
        line-height: 1.75;
        color: var(--text-dim);
        margin-bottom: 1rem;
    }

    .ad-slot {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        max-width: 1200px;
        margin: 25px auto;
        padding: 0 15px;
        min-height: 100px;
        overflow: hidden;
    }
</style>
