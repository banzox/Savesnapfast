---
import { useTranslations } from "../utils/i18n";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  lang: string;
  headings: Heading[];
}

const { lang, headings } = Astro.props;
const t = useTranslations(lang);

// Only show H2 and H3
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <div class="toc-container">
    <div class="toc-header">
      <i class="fas fa-list-ul"></i>
      <h3>{t("blog.toc_title")}</h3>
    </div>
    <ul class="toc-list">
      {filteredHeadings.map((heading) => (
        <li class={`toc-item depth-${heading.depth}`}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .toc-container {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 25px;
    margin: 0 0 40px 0;
  }

  :global([data-theme="light"]) .toc-container {
    background: #f8fafc;
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 15px;
  }

  .toc-header i {
    color: var(--secondary);
    font-size: 1.2rem;
  }

  .toc-header h3 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--text-main);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin-bottom: 10px;
  }

  .toc-item:last-child {
    margin-bottom: 0;
  }

  .toc-item.depth-3 {
    padding-inline-start: 20px;
    font-size: 0.95rem;
  }

  .toc-item.depth-3::before {
    content: "•";
    color: var(--secondary);
    display: inline-block;
    width: 15px;
  }

  .toc-item a {
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.2s;
  }

  .toc-item a:hover {
    color: var(--secondary);
    text-decoration: underline;
  }
</style>
