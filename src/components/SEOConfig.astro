---
/**
 * SEOConfig.astro
 * Advanced SEO component that programmatically generates:
 * 1. Canonical URL tag (absolute, using Astro.url)
 * 2. Dynamic hreflang tags for all 30 supported languages
 * 3. Self-referencing hreflang for the current language
 * 4. x-default hreflang pointing to the English version
 *
 * All generated URLs are absolute (https://savetik-fast.xyz/...)
 */
import { languages } from "../i18n/ui";

const SITE_ORIGIN = "https://savetik-fast.xyz";

// --- 1. Extract the base slug (path without language prefix) ---
// Strips trailing slash for clean comparison (trailingSlash: 'never')
const rawPath = Astro.url.pathname.replace(/\.html$/, "");
const pathname = rawPath.endsWith("/") && rawPath.length > 1
    ? rawPath.slice(0, -1)
    : rawPath;
const pathParts = pathname.split("/").filter(Boolean);
const firstPart = pathParts[0];
const isLangPrefix = firstPart && Object.keys(languages).includes(firstPart);
const baseSlug = isLangPrefix
    ? pathParts.slice(1).join("/")
    : pathParts.join("/");

// --- 2. Build canonical URL (absolute, NO trailing slash — matches trailingSlash:'never') ---
const canonicalURL = new URL(pathname, SITE_ORIGIN).href;

// --- 3. Build hreflang entries for ALL languages (NO trailing slashes) ---
// For blog post pages, link to the blog index in other languages
// since blog posts don't exist in all languages
const isBlogPost = baseSlug && baseSlug.startsWith("blog/") && baseSlug !== "blog";
const hreflangs = Object.keys(languages).map((langCode) => {
    // For blog posts, other languages should point to /[lang]/blog
    const slug = isBlogPost ? "blog" : baseSlug;
    
    const langPath =
        langCode === "en"
            ? slug
                ? `/${slug}`
                : "/"
            : slug
              ? `/${langCode}/${slug}`
              : `/${langCode}`;

    return {
        lang: langCode,
        href: new URL(langPath, SITE_ORIGIN).href,
    };
});

// --- 4. x-default always points to the English version of the same page ---
const xDefaultSlug = isBlogPost ? "blog" : baseSlug;
const xDefaultHref = new URL(
    xDefaultSlug ? `/${xDefaultSlug}` : "/",
    SITE_ORIGIN,
).href;
---

<!-- SEOConfig: Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- SEOConfig: hreflang x-default (English fallback) -->
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

<!-- SEOConfig: hreflang for all 30 languages (including self-reference) -->
{
    hreflangs.map(({ lang, href }) => (
        <link rel="alternate" hreflang={lang} href={href} />
    ))
}
