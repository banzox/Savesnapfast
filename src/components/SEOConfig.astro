---
/**
 * SEOConfig.astro
 * Generates:
 * 1. Self-referencing Canonical URL tag (absolute, no trailing slash)
 * 2. Dynamic hreflang tags for all 30 supported languages on multilingual routes
 * 3. Self-referencing hreflang for the current language
 * 4. x-default hreflang pointing to the English version
 */
import { languages } from "../i18n/ui";

const SITE_ORIGIN = "https://savetik-fast.xyz";

interface Props {
    noindex?: boolean;
}

const { noindex = false } = Astro.props;

// --- 1. Extract the base slug (path without language prefix) ---
const rawPath = Astro.url.pathname.replace(/\.html$/, "");
const pathname = rawPath.endsWith("/") && rawPath.length > 1
    ? rawPath.slice(0, -1)
    : rawPath;
const pathParts = pathname.split("/").filter(Boolean);
const firstPart = pathParts[0];
const isLangPrefix = firstPart && Object.keys(languages).includes(firstPart);
const baseSlug = isLangPrefix
    ? pathParts.slice(1).join("/")
    : pathParts.join("/");

// --- 2. Build canonical URL ---
const canonicalURL = new URL(pathname || "/", SITE_ORIGIN).href;

// --- 3. Build hreflang entries for multilingual core routes ---
const currentLang = isLangPrefix ? firstPart : "en";
const isBlogPost = baseSlug && baseSlug.startsWith("blog/") && baseSlug !== "blog";
const is404Page = pathname.includes("404") || baseSlug === "404";

const EN_ONLY_LEGAL_PAGES = new Set([
    "about",
    "contact",
    "disclaimer",
    "dmca",
    "privacy",
    "terms",
    "editorial-policy",
]);
const hasLocalizedIndexableVersions = !EN_ONLY_LEGAL_PAGES.has(baseSlug);

// Skip hreflang on 404s, noindex pages, non-equivalent blog articles, and English-canonical legal pages
const skipHreflang = noindex || is404Page || isBlogPost || !hasLocalizedIndexableVersions;

const hreflangs = skipHreflang ? [] : Object.keys(languages).map((langCode) => {
    const slug = baseSlug;
    const langPath =
        langCode === "en"
            ? slug
                ? `/${slug}`
                : "/"
            : slug
              ? `/${langCode}/${slug}`
              : `/${langCode}`;

    return {
        lang: langCode,
        href: new URL(langPath, SITE_ORIGIN).href,
    };
});

// --- 4. x-default points to the English version of the same page ---
const xDefaultHref = new URL(
    baseSlug ? `/${baseSlug}` : "/",
    SITE_ORIGIN,
).href;
---

<!-- SEOConfig: Canonical URL -->
<link rel="canonical" href={canonicalURL} />

{!skipHreflang && (
    <>
        <!-- SEOConfig: hreflang x-default (English fallback) -->
        <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

        <!-- SEOConfig: hreflang for all 30 languages (including self-reference) -->
        {
            hreflangs.map(({ lang, href }) => (
                <link rel="alternate" hreflang={lang} href={href} />
            ))
        }
    </>
)}
