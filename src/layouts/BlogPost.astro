---
import Layout from "./Layout.astro";
import AdSenseSlot from "../components/AdSenseSlot.astro";
import { useTranslations } from "../utils/i18n";
import { ADS_CONFIG } from "../config";
import TableOfContents from "../components/TableOfContents.astro";
import SocialShare from "../components/SocialShare.astro";
import { getCollection } from "astro:content";

interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    title: string;
    description: string;
    cover?: string;
    author: string;
    pubDate: Date;
    lang: string;
    headings?: Heading[];
    slug?: string;
}

const { title, description, cover, author, pubDate, lang, headings = [], slug = "" } = Astro.props;
const t = useTranslations(lang);
const showAdsterra = ADS_CONFIG.enableAdsterra;
const showAdSense = ADS_CONFIG.enableAdSense;

const intlLocale = lang === "fil" ? "fil-PH" : lang === "no" ? "nb-NO" : lang;
let formattedDate = pubDate.toISOString().slice(0, 10);
try {
    formattedDate = new Intl.DateTimeFormat(intlLocale, {
        year: "numeric",
        month: "long",
        day: "numeric",
    }).format(pubDate);
} catch {}

const homeHref = lang === "en" ? "/" : `/${lang}`;
const blogHref = lang === "en" ? "/blog" : `/${lang}/blog`;
const currentUrl = new URL(Astro.url.pathname.replace(/\.html$/, ""), Astro.site || "https://savetik-fast.xyz").href;

// Deterministic related posts (sorted newest first)
const allPosts = await getCollection("blog");
const relatedPosts = allPosts
    .filter((post) => (post.data.lang || "en") === lang && post.slug !== slug)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
---

<Layout
    title={title}
    description={description}
    lang={lang}
    pageType="article"
    articleData={{
        headline: title,
        description,
        image: cover,
        datePublished: pubDate.toISOString(),
        authorName: author,
    }}
>
    <div class="article-container">
        <nav class="article-breadcrumb" aria-label="Breadcrumb">
            <a href={homeHref}>{t("nav.home")}</a>
            <i class="fas fa-chevron-right"></i>
            <a href={blogHref}>{t("blog.title")}</a>
            <i class="fas fa-chevron-right"></i>
            <span>{title}</span>
        </nav>

        <article class="blog-post">
            <header class="post-header">
                <h1 class="post-title">{title}</h1>
                <div class="post-meta">
                    <span class="post-author">
                        <i class="fas fa-user"></i> {author}
                    </span>
                    <span class="post-date">
                        <i class="fas fa-calendar-alt"></i>
                        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
                    </span>
                </div>
                {cover && (
                    <div class="post-cover">
                        <img src={cover} alt={title} loading="eager" />
                    </div>
                )}
            </header>

            {showAdSense && (
                <AdSenseSlot
                    slot={ADS_CONFIG.adsenseSlots.blogInArticle}
                    format="fluid"
                    layout="in-article"
                />
            )}

            {showAdsterra && (
                <div class="blog-ad-container blog-ad-top">
                    <iframe
                        src="/ad-native"
                        style="width:100%;height:250px;border:none;overflow:hidden;"
                        scrolling="no"
                        loading="lazy"
                        title="Advertisement"
                    ></iframe>
                </div>
            )}

            {headings.length > 0 && <TableOfContents headings={headings} lang={lang} />}

            <div class="post-content">
                <slot />
            </div>

            {showAdSense && (
                <AdSenseSlot slot={ADS_CONFIG.adsenseSlots.midContent} />
            )}

            <SocialShare url={currentUrl} title={title} lang={lang} />

            {relatedPosts.length > 0 && (
                <div class="related-posts">
                    <h2>{t("blog.related_posts_title")}</h2>
                    <div class="related-grid">
                        {relatedPosts.map((post) => {
                            const postSlug = lang === "en" ? `/blog/${post.slug}` : `/${lang}/blog/${post.slug}`;
                            return (
                                <a href={postSlug} class="related-card">
                                    {post.data.cover && (
                                        <div class="related-img-container">
                                            <img src={post.data.cover} alt={post.data.title} loading="lazy" />
                                        </div>
                                    )}
                                    <div class="related-content">
                                        <h3>{post.data.title}</h3>
                                    </div>
                                </a>
                            );
                        })}
                    </div>
                </div>
            )}

            <footer class="post-footer">
                <div class="cta-box">
                    <h2>{t("blog.cta_title")}</h2>
                    <p>{t("blog.cta_desc")}</p>
                    <a href={homeHref} class="cta-button">
                        <i class="fas fa-download"></i>
                        {t("blog.cta_button")}
                    </a>
                </div>
            </footer>
        </article>
    </div>
</Layout>

<script>
    document.addEventListener("astro:page-load", () => {
        const contentLinks = document.querySelectorAll(".post-content a");
        contentLinks.forEach((link) => {
            if (link instanceof HTMLAnchorElement && link.hostname && link.hostname !== window.location.hostname) {
                link.setAttribute("target", "_blank");
                link.setAttribute("rel", "noopener noreferrer");
            }
        });
    });
</script>

<style>
    .article-container {
        max-width: 820px;
        margin: 0 auto;
        padding: 20px;
    }

    .article-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 30px;
        font-size: 0.9rem;
        color: var(--text-dim);
    }

    .article-breadcrumb a {
        color: var(--text-dim);
        text-decoration: none;
        transition: color 0.3s;
    }

    .article-breadcrumb a:hover {
        color: var(--secondary);
    }

    .article-breadcrumb i {
        font-size: 0.7rem;
        opacity: 0.5;
    }

    .blog-post {
        background: var(--glass);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: clamp(22px, 4vw, 42px);
        overflow: hidden;
    }

    :global([data-theme="light"]) .blog-post {
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    }

    .post-header {
        margin-bottom: 36px;
        text-align: center;
    }

    .post-title {
        font-size: clamp(1.75rem, 4vw, 2.45rem);
        font-weight: 800;
        line-height: 1.25;
        margin-bottom: 18px;
        background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .post-meta {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px;
        color: var(--text-dim);
        font-size: 0.95rem;
        margin-bottom: 28px;
    }

    .post-meta i {
        margin-inline-end: 5px;
        color: var(--secondary);
    }

    .post-cover {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
    }

    .post-cover img {
        width: 100%;
        height: auto;
        display: block;
    }

    .post-content {
        color: var(--text-main);
        line-height: 1.85;
        font-size: 1.12rem;
    }

    .post-content :global(h2) {
        font-size: 1.65rem;
        margin: 38px 0 18px;
        color: var(--secondary);
    }

    .post-content :global(h3) {
        font-size: 1.32rem;
        margin: 28px 0 14px;
    }

    .post-content :global(p) {
        margin-bottom: 18px;
    }

    .post-content :global(ul),
    .post-content :global(ol) {
        margin-bottom: 20px;
        padding-inline-start: 22px;
    }

    .post-content :global(li) {
        margin-bottom: 10px;
    }

    .post-content :global(strong) {
        color: var(--secondary);
    }

    .post-content :global(a) {
        color: var(--secondary);
        text-decoration: underline;
    }

    .post-footer {
        margin-top: 55px;
        padding-top: 38px;
        border-top: 1px solid var(--border);
    }

    .cta-box {
        text-align: center;
        padding: 36px;
        background: rgba(255, 0, 80, 0.05);
        border-radius: 15px;
        border: 1px dashed var(--secondary);
    }

    .cta-box h2 {
        font-size: 1.45rem;
        margin-bottom: 14px;
    }

    .cta-box p {
        color: var(--text-dim);
        margin-bottom: 24px;
    }

    .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 35px;
        background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
        color: white;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 700;
        transition: transform 0.3s, box-shadow 0.3s;
        box-shadow: 0 10px 25px var(--primary-glow);
    }

    .related-posts {
        margin: 48px 0;
    }

    .related-posts h2 {
        font-size: 1.45rem;
        margin-bottom: 24px;
        color: var(--text-main);
        text-align: center;
    }

    .related-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
    }

    .related-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        color: var(--text-main);
        transition: transform 0.3s, box-shadow 0.3s;
        display: flex;
        flex-direction: column;
    }

    :global([data-theme="light"]) .related-card {
        background: #f8fafc;
    }

    .related-card:hover {
        transform: translateY(-4px);
        border-color: var(--secondary);
    }

    .related-img-container {
        width: 100%;
        height: 120px;
        overflow: hidden;
    }

    .related-img-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .related-content {
        padding: 15px;
        flex: 1;
    }

    .related-content h3 {
        font-size: 0.98rem;
        margin: 0;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
