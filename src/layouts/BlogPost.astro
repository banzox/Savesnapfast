---
import Layout from "./Layout.astro";
import { useTranslations } from "../utils/i18n";
import { ADS_CONFIG } from "../config";

interface Props {
	title: string;
	description: string;
	cover?: string;
	author: string;
	pubDate: Date;
	lang: string;
}

const { title, description, cover, author, pubDate, lang } = Astro.props;
const t = useTranslations(lang);
const showAds = ADS_CONFIG.enableAdsterra;

const formattedDate = new Intl.DateTimeFormat(lang === 'ar' ? 'ar-EG' : 'en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
}).format(pubDate);

const homeHref = lang === "en" ? "/" : `/${lang}`;
const blogHref = lang === "en" ? "/blog" : `/${lang}/blog`;
---

<Layout title={title} description={description} lang={lang}>
	<div class="article-container">
		<nav class="article-breadcrumb">
			<a href={homeHref}>{t("nav.home")}</a>
			<i class="fas fa-chevron-right"></i>
			<a href={blogHref}>{t("blog.title")}</a>
			<i class="fas fa-chevron-right"></i>
			<span>{title}</span>
		</nav>

		<article class="blog-post">
			<header class="post-header">
				<h1 class="post-title">{title}</h1>
				<div class="post-meta">
					<span class="post-author">
						<i class="fas fa-user"></i> {author}
					</span>
					<span class="post-date">
						<i class="fas fa-calendar-alt"></i> {formattedDate}
					</span>
				</div>
				{cover && (
					<div class="post-cover">
						<img src={cover} alt={title} loading="lazy" />
					</div>
				)}
			</header>

			{/* Ad: Native Banner - after header */}
			{showAds && (
				<div class="blog-ad-container blog-ad-top">
					<iframe
						src="/ad-native.html"
						style="width:100%;height:250px;border:none;overflow:hidden;"
						scrolling="no"
						loading="lazy"
					></iframe>
				</div>
			)}

			<div class="post-content">
				<slot />
			</div>

			{/* Ad: 300x250 Banner - after content */}
			{showAds && (
				<div class="blog-ad-container blog-ad-bottom">
					<iframe
						src="/ad-300x250.html"
						style="width:300px;height:250px;border:none;overflow:hidden;"
						scrolling="no"
						loading="lazy"
					></iframe>
				</div>
			)}

			<footer class="post-footer">
				<div class="cta-box">
					<h3>{t("blog.cta_title")}</h3>
					<p>{t("blog.cta_desc")}</p>
					<a href={homeHref} class="cta-button">
						<i class="fas fa-download"></i>
						{t("blog.cta_button")}
					</a>
				</div>
			</footer>
		</article>
	</div>
</Layout>

<style>
	.article-container {
		max-width: 800px;
		margin: 0 auto;
		padding: 20px;
	}

	.article-breadcrumb {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 30px;
		font-size: 0.9rem;
		color: var(--text-dim);
	}

	.article-breadcrumb a {
		color: var(--text-dim);
		text-decoration: none;
		transition: color 0.3s;
	}

	.article-breadcrumb a:hover {
		color: var(--secondary);
	}

	.article-breadcrumb i {
		font-size: 0.7rem;
		opacity: 0.5;
	}

	.blog-post {
		background: var(--glass);
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 40px;
		overflow: hidden;
	}

	:global([data-theme="light"]) .blog-post {
		background: #ffffff;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
	}

	.post-header {
		margin-bottom: 40px;
		text-align: center;
	}

	.post-title {
		font-size: 2.5rem;
		font-weight: 800;
		line-height: 1.2;
		margin-bottom: 20px;
		background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.post-meta {
		display: flex;
		justify-content: center;
		gap: 20px;
		color: var(--text-dim);
		font-size: 0.95rem;
		margin-bottom: 30px;
	}

	.post-meta i {
		margin-right: 5px;
		color: var(--secondary);
	}

	.post-cover {
		border-radius: 15px;
		overflow: hidden;
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
	}

	.post-cover img {
		width: 100%;
		height: auto;
		display: block;
	}

	.post-content {
		color: var(--text-main);
		line-height: 1.8;
		font-size: 1.15rem;
	}

	.post-content :global(h2) {
		font-size: 1.8rem;
		margin: 40px 0 20px;
		color: var(--secondary);
	}

	.post-content :global(h3) {
		font-size: 1.4rem;
		margin: 30px 0 15px;
	}

	.post-content :global(p) {
		margin-bottom: 20px;
	}

	.post-content :global(ul), .post-content :global(ol) {
		margin-bottom: 20px;
		padding-left: 20px;
	}

	.post-content :global(li) {
		margin-bottom: 10px;
	}

	.post-content :global(strong) {
		color: var(--secondary);
	}

	.post-content :global(a) {
		color: var(--secondary);
		text-decoration: underline;
	}

	.post-footer {
		margin-top: 60px;
		padding-top: 40px;
		border-top: 1px solid var(--border);
	}

	.cta-box {
		text-align: center;
		padding: 40px;
		background: rgba(255, 0, 80, 0.05);
		border-radius: 15px;
		border: 1px dashed var(--secondary);
	}

	.cta-box h3 {
		font-size: 1.5rem;
		margin-bottom: 15px;
	}

	.cta-box p {
		color: var(--text-dim);
		margin-bottom: 25px;
	}

	.cta-button {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 14px 35px;
		background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
		color: white;
		text-decoration: none;
		border-radius: 10px;
		font-weight: 700;
		transition: transform 0.3s, box-shadow 0.3s;
		box-shadow: 0 10px 25px var(--primary-glow);
	}

	.cta-button:hover {
		transform: translateY(-3px);
		box-shadow: 0 15px 35px var(--primary-glow);
	}

	@media (max-width: 768px) {
		.post-title {
			font-size: 1.8rem;
		}

		.blog-post {
			padding: 25px;
		}

		.post-meta {
			flex-direction: column;
			gap: 10px;
			align-items: center;
		}

		.blog-ad-bottom iframe {
			width: 100% !important;
			max-width: 300px;
		}
	}

	/* Blog Ad Containers */
	.blog-ad-container {
		display: flex;
		justify-content: center;
		align-items: center;
		margin: 30px 0;
		border-radius: 12px;
		overflow: hidden;
	}

	.blog-ad-top {
		margin-top: 0;
		margin-bottom: 35px;
	}

	.blog-ad-bottom {
		margin-top: 40px;
		margin-bottom: 10px;
	}
</style>
