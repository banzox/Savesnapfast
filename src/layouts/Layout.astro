---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Schema from "../components/Schema.astro";
import Footer from "../components/Footer.astro";
import SEOHead from "../components/SEOHead.astro";
import SEOConfig from "../components/SEOConfig.astro";
import { ViewTransitions } from "astro:transitions";
import { ADS_CONFIG } from "../config";

interface Props {
    title: string;
    description: string;
    lang?: string;
    keywords?: string;
    noindex?: boolean;
}

const { title, description, lang = "en", keywords, noindex = false } = Astro.props;
const currentPageURL = new URL(Astro.url.pathname.replace(/\.html$/, ""), "https://savetik-fast.xyz").href;
const is404 = noindex || Astro.url.pathname.includes("404");
const robotsContent = is404 
    ? "noindex, follow" 
    : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---

<!doctype html>
<html lang={lang} dir={lang === "ar" ? "rtl" : "ltr"}>
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        {keywords && <meta name="keywords" content={keywords} />}
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- Deferred Ad Loading to boost PageSpeed performance -->
        <script is:inline define:vars={{ enableAdsterra: ADS_CONFIG.enableAdsterra }}>
            (function() {
                let adsLoaded = false;
                function loadAds() {
                    if (adsLoaded) return;
                    adsLoaded = true;

                    // Load Adsterra Social Bar if enabled
                    if (enableAdsterra) {
                        const adsterra = document.createElement("script");
                        adsterra.src = "https://ferocitycandour.com/40/30/09/403009a90d32a66dcba80b1e5510e001.js";
                        adsterra.async = true;
                        adsterra.defer = true;
                        document.head.appendChild(adsterra);
                    }
                }

                // Trigger loading on user interaction (scroll, click, mousemove, touchstart)
                ["scroll", "mousemove", "touchstart", "click"].forEach(event => {
                    window.addEventListener(event, loadAds, { once: true, passive: true });
                });

                // Fallback: load ads after 6 seconds in case of no interaction
                window.addEventListener('load', () => {
                    setTimeout(loadAds, 6000);
                });
            })();
        </script>



        <!-- Google Analytics - Deferred loading for better FCP -->
        <script is:inline>
            // Defer GA loading until after page becomes interactive
            window.addEventListener('load', function() {
                setTimeout(function() {
                    var gs = document.createElement('script');
                    gs.src = 'https://www.googletagmanager.com/gtag/js?id=G-MK86W8GK18';
                    gs.async = true;
                    document.head.appendChild(gs);
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    window.gtag = gtag;
                    gtag('js', new Date());
                    gtag('config', 'G-MK86W8GK18');
                }, 100);
            });

            // تسجيل الصفحات بدقة مع انتقالات Astro (ViewTransitions)
            document.addEventListener('astro:page-load', () => {
                if (window.gtag) {
                    window.gtag('config', 'G-MK86W8GK18', { page_path: window.location.pathname });
                }
            });
        </script>

        <!-- Critical CSS: Inline for faster FCP -->
        <style is:inline>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }
            html {
                scroll-behavior: smooth;
            }
            body {
                background: #0a0a0a;
                color: #fff;
                font-family: "Inter", "Tajawal", system-ui, sans-serif;
                line-height: 1.6;
                min-height: 100vh;
            }
            [data-theme="light"] body {
                background: #f8fafc;
                color: #0f172a;
            }
            .hero-section {
                min-height: 50vh;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 2rem 1rem;
            }
            .downloader-wrapper {
                width: 100%;
                max-width: 48rem;
                margin: 0 auto;
            }
            /* Font Display Optimization - Override FA fonts */
            @font-face {
                font-display: swap !important;
            }
        </style>
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
        <link rel="apple-touch-icon" href="/favicon.png" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <ViewTransitions />

        <!-- Preconnect hints for critical resources only -->
        <link
            rel="preconnect"
            href="https://cdnjs.cloudflare.com"
            crossorigin
        />
        <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />


        <!-- Font Awesome - Async loading with font-display: swap -->
        <link
            rel="preload"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/fontawesome.min.css"
            as="style"
            crossorigin
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <link
            rel="preload"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/solid.min.css"
            as="style"
            crossorigin
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <link
            rel="preload"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/brands.min.css"
            as="style"
            crossorigin
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <!-- Override Font Awesome font-display to swap -->
        <style is:inline>
            @font-face {
                font-family: 'Font Awesome 6 Free';
                font-display: swap !important;
            }
            @font-face {
                font-family: 'Font Awesome 6 Brands';
                font-display: swap !important;
            }
        </style>
        <noscript>
            <link
                rel="stylesheet"
                href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/fontawesome.min.css"
            />
            <link
                rel="stylesheet"
                href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/solid.min.css"
            />
            <link
                rel="stylesheet"
                href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/brands.min.css"
            />
        </noscript>

        <SEOConfig noindex={is404} />

        <Schema lang={lang} noindex={is404} />
        <SEOHead lang={lang} />

        <meta name="robots" content={robotsContent} />
        <meta name="googlebot" content={is404 ? "noindex, follow" : "index, follow, max-image-preview:large"} />
        <meta name="bingbot" content={is404 ? "noindex, follow" : "index, follow"} />
        <meta name="author" content="SaveTikFast" />
        <meta name="publisher" content="SaveTikFast" />
        <meta name="rating" content="general" />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={currentPageURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta
            property="og:image"
            content="https://savetik-fast.xyz/og-image.png"
        />
        <meta property="og:site_name" content="SaveTikFast" />
        <meta property="og:locale" content={
            lang === "en" ? "en_US" :
            lang === "ar" ? "ar_SA" :
            lang === "zh" ? "zh_CN" :
            lang === "fil" ? "fil_PH" :
            lang === "uk" ? "uk_UA" :
            lang === "vi" ? "vi_VN" :
            lang === "hi" ? "hi_IN" :
            lang === "ko" ? "ko_KR" :
            lang === "ja" ? "ja_JP" :
            lang === "th" ? "th_TH" :
            lang === "pt" ? "pt_BR" :
            lang === "ms" ? "ms_MY" :
            lang === "id" ? "id_ID" :
            `${lang}_${lang.toUpperCase()}`
        } />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={currentPageURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta
            name="twitter:image"
            content="https://savetik-fast.xyz/og-image.png"
        />

        <link rel="manifest" href="/manifest.json" />

        <!-- Preconnect for font file origin -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <!-- Fonts - Non-blocking async loading -->
        <link
            href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&family=Inter:wght@400;700&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&family=Inter:wght@400;700&display=swap"
                rel="stylesheet"
            />
        </noscript>

        <script is:inline>
            // ===============================================
            // UNIFIED THEME SYSTEM - Persistent across pages
            // ===============================================
            (function () {
                const THEME_KEY = "theme";

                function getStoredTheme() {
                    try {
                        return localStorage.getItem(THEME_KEY);
                    } catch {
                        return null;
                    }
                }

                function getSystemTheme() {
                    return window.matchMedia("(prefers-color-scheme: light)")
                        .matches
                        ? "light"
                        : "dark";
                }

                function getTheme() {
                    return getStoredTheme() || getSystemTheme();
                }

                function applyTheme(theme, save = true) {
                    if (theme === "light") {
                        document.documentElement.setAttribute(
                            "data-theme",
                            "light",
                        );
                    } else {
                        document.documentElement.removeAttribute("data-theme");
                    }
                    if (save) {
                        try {
                            localStorage.setItem(THEME_KEY, theme);
                        } catch {}
                    }
                    // Dispatch custom event for icon updates
                    window.dispatchEvent(
                        new CustomEvent("theme-changed", { detail: { theme } }),
                    );
                }

                // Apply immediately on first load
                applyTheme(getTheme());

                // Expose globally for Navbar toggle
                window.__theme = {
                    getTheme,
                    applyTheme,
                    toggle: function () {
                        const current = getTheme();
                        const next = current === "dark" ? "light" : "dark";
                        applyTheme(next);
                        return next;
                    },
                };

                // Re-apply on View Transitions swap
                document.addEventListener("astro:after-swap", () => {
                    applyTheme(getTheme(), false);
                });

                // Also handle before swap to prevent flash
                document.addEventListener("astro:before-swap", (e) => {
                    const theme = getTheme();
                    if (theme === "light") {
                        e.newDocument.documentElement.setAttribute(
                            "data-theme",
                            "light",
                        );
                    }
                });
            })();
        </script>
    </head>
    <body>
        <Navbar lang={lang} />

        <main id="main-content" class="page-enter">
            <slot />
        </main>

        <Footer lang={lang} />

        <!-- PART 3: Bulletproof Toggle Script -->
        <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
                const btn = document.getElementById("menu-btn");
                const sidebar = document.querySelector(".nav-links"); // Using class from Navbar
                const overlay = document.getElementById("nav-overlay");

                if (btn && sidebar) {
                    btn.addEventListener("click", (e) => {
                        e.stopPropagation(); // Stop bubbling
                        sidebar.classList.toggle("active");
                        btn.classList.toggle("active");
                        if (overlay) overlay.classList.toggle("active");
                        document.body.style.overflow =
                            sidebar.classList.contains("active")
                                ? "hidden"
                                : "";
                    });

                    // Close on overlay click
                    if (overlay) {
                        overlay.addEventListener("click", () => {
                            sidebar.classList.remove("active");
                            btn.classList.remove("active");
                            overlay.classList.remove("active");
                            document.body.style.overflow = "";
                        });
                    }
                }
            });
        </script>
            <!-- Scroll to Top Button -->
        <button id="scrollToTop" aria-label="Scroll to top" title="Scroll to top">
            <i class="fas fa-arrow-up"></i>
        </button>
        <script is:inline>
            (function() {
                const initScrollToTop = () => {
                    const btn = document.getElementById('scrollToTop');
                    if (!btn) return;
                    
                    window.addEventListener('scroll', () => {
                        if (window.scrollY > 300) {
                            btn.classList.add('visible');
                        } else {
                            btn.classList.remove('visible');
                        }
                    }, { passive: true });

                    btn.addEventListener('click', () => {
                        window.scrollTo({
                            top: 0,
                            behavior: 'smooth'
                        });
                    });
                };
                
                initScrollToTop();
                document.addEventListener('astro:page-load', initScrollToTop);
            })();
        </script>
    </body>
</html>
