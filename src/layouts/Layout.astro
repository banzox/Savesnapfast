---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Schema from "../components/Schema.astro";
import Footer from "../components/Footer.astro";
import SEOHead from "../components/SEOHead.astro";
import SEOConfig from "../components/SEOConfig.astro";
import { ClientRouter } from "astro:transitions";
import { ADS_CONFIG } from "../config";

interface Props {
    title: string;
    description: string;
    lang?: string;
    keywords?: string;
    noindex?: boolean;
    pageType?: "tool" | "article" | "page";
    articleData?: {
        headline: string;
        description: string;
        image?: string;
        datePublished: string;
        dateModified?: string;
        authorName: string;
    };
}

const {
    title,
    description,
    lang = "en",
    noindex = false,
    pageType = "tool",
    articleData,
} = Astro.props;

const cleanPathname = Astro.url.pathname.replace(/\.html$/, "");
const normalizedPathname = cleanPathname.length > 1 && cleanPathname.endsWith("/")
    ? cleanPathname.slice(0, -1)
    : cleanPathname;
const currentPageURL = new URL(normalizedPathname || "/", "https://savetik-fast.xyz").href;
const is404 = noindex || Astro.url.pathname.includes("404");
const robotsContent = is404
    ? "noindex, follow"
    : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const OG_LOCALE_MAP: Record<string, string> = {
    en: "en_US",
    ar: "ar_SA",
    es: "es_ES",
    pt: "pt_BR",
    id: "id_ID",
    fr: "fr_FR",
    de: "de_DE",
    it: "it_IT",
    tr: "tr_TR",
    ru: "ru_RU",
    vi: "vi_VN",
    th: "th_TH",
    ja: "ja_JP",
    ko: "ko_KR",
    pl: "pl_PL",
    nl: "nl_NL",
    ro: "ro_RO",
    ms: "ms_MY",
    fil: "fil_PH",
    uk: "uk_UA",
    cs: "cs_CZ",
    sv: "sv_SE",
    hu: "hu_HU",
    el: "el_GR",
    da: "da_DK",
    fi: "fi_FI",
    no: "nb_NO",
    bg: "bg_BG",
    zh: "zh_CN",
    hi: "hi_IN",
};
const ogLocale = OG_LOCALE_MAP[lang] || "en_US";
---

<!doctype html>
<html lang={lang} dir={lang === "ar" ? "rtl" : "ltr"}>
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        {/* AdSense strictly loaded ONLY on indexable publisher-content pages (never on 404/noindex or legal policy pages) */}
        {!is404 && pageType !== "page" && ADS_CONFIG.enableAdSense && (
            <script
                async
                is:inline
                src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS_CONFIG.adsenseClient}`}
                crossorigin="anonymous"
            ></script>
        )}

        <!-- Google Analytics - Deferred loading for better FCP -->
        <script is:inline>
            window.addEventListener('load', function() {
                setTimeout(function() {
                    var gs = document.createElement('script');
                    gs.src = 'https://www.googletagmanager.com/gtag/js?id=G-MK86W8GK18';
                    gs.async = true;
                    document.head.appendChild(gs);
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    window.gtag = gtag;
                    gtag('js', new Date());
                    gtag('config', 'G-MK86W8GK18');
                }, 100);
            });

            document.addEventListener('astro:page-load', () => {
                if (window.gtag) {
                    window.gtag('config', 'G-MK86W8GK18', { page_path: window.location.pathname });
                }
            });
        </script>

        <!-- Critical CSS: Inline for faster FCP -->
        <style is:inline>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }
            html {
                scroll-behavior: smooth;
            }
            body {
                background: #0a0a0a;
                color: #fff;
                font-family: "Inter", "Tajawal", system-ui, sans-serif;
                line-height: 1.6;
                min-height: 100vh;
            }
            [data-theme="light"] body {
                background: #f8fafc;
                color: #0f172a;
            }
            .hero-section {
                min-height: 50vh;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 2rem 1rem;
            }
            .downloader-wrapper {
                width: 100%;
                max-width: 48rem;
                margin: 0 auto;
            }
            @font-face {
                font-display: swap !important;
            }
        </style>
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
        <link rel="apple-touch-icon" href="/favicon.png" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <ClientRouter />

        <!-- Preconnect hints for critical resources -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
        <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />
        {!is404 && <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />}

        <!-- Google Fonts - Asynchronously loaded with display=swap -->
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Tajawal:wght@400;500;700;800;900&family=Cairo:wght@600;700;800&display=swap"
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <noscript>
            <link
                rel="stylesheet"
                href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Tajawal:wght@400;500;700;800;900&family=Cairo:wght@600;700;800&display=swap"
            />
        </noscript>

        <!-- Font Awesome - Async loading with font-display: swap -->
        <link
            rel="preload"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/fontawesome.min.css"
            as="style"
            crossorigin
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <link
            rel="preload"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/solid.min.css"
            as="style"
            crossorigin
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <link
            rel="preload"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/brands.min.css"
            as="style"
            crossorigin
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <style is:inline>
            @font-face {
                font-family: 'Font Awesome 6 Free';
                font-display: swap !important;
            }
            @font-face {
                font-family: 'Font Awesome 6 Brands';
                font-display: swap !important;
            }
        </style>
        <noscript>
            <link
                rel="stylesheet"
                href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/fontawesome.min.css"
            />
            <link
                rel="stylesheet"
                href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/solid.min.css"
            />
            <link
                rel="stylesheet"
                href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/brands.min.css"
            />
        </noscript>

        <SEOConfig noindex={is404} />

        <Schema lang={lang} noindex={is404} pageType={pageType} articleData={articleData} />
        <SEOHead lang={lang} />

        <meta name="robots" content={robotsContent} />
        <meta name="googlebot" content={is404 ? "noindex, follow" : "index, follow, max-image-preview:large"} />
        <meta name="bingbot" content={is404 ? "noindex, follow" : "index, follow"} />
        <meta name="author" content="SaveTikFast" />
        <meta name="publisher" content="SaveTikFast" />
        <meta name="rating" content="general" />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={pageType === "article" ? "article" : "website"} />
        <meta property="og:url" content={currentPageURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta
            property="og:image"
            content={articleData?.image ? new URL(articleData.image, "https://savetik-fast.xyz").href : "https://savetik-fast.xyz/og-image.png"}
        />
        <meta property="og:site_name" content="SaveTikFast" />
        <meta property="og:locale" content={ogLocale} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={currentPageURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta
            name="twitter:image"
            content={articleData?.image ? new URL(articleData.image, "https://savetik-fast.xyz").href : "https://savetik-fast.xyz/og-image.png"}
        />

        <link rel="manifest" href="/manifest.json" />

        <script is:inline>
            (function () {
                const THEME_KEY = "theme";

                function getStoredTheme() {
                    try {
                        return localStorage.getItem(THEME_KEY);
                    } catch {
                        return null;
                    }
                }

                function getSystemTheme() {
                    return window.matchMedia("(prefers-color-scheme: light)")
                        .matches
                        ? "light"
                        : "dark";
                }

                function getTheme() {
                    return getStoredTheme() || getSystemTheme();
                }

                function applyTheme(theme, save = true) {
                    if (theme === "light") {
                        document.documentElement.setAttribute(
                            "data-theme",
                            "light",
                        );
                    } else {
                        document.documentElement.removeAttribute("data-theme");
                    }
                    if (save) {
                        try {
                            localStorage.setItem(THEME_KEY, theme);
                        } catch {}
                    }
                    window.dispatchEvent(
                        new CustomEvent("theme-changed", { detail: { theme } }),
                    );
                }

                applyTheme(getTheme());

                window.__theme = {
                    getTheme,
                    applyTheme,
                    toggle: function () {
                        const current = getTheme();
                        const next = current === "dark" ? "light" : "dark";
                        applyTheme(next);
                        return next;
                    },
                };

                document.addEventListener("astro:after-swap", () => {
                    applyTheme(getTheme(), false);
                });

                document.addEventListener("astro:before-swap", (e) => {
                    const theme = getTheme();
                    if (theme === "light") {
                        e.newDocument.documentElement.setAttribute(
                            "data-theme",
                            "light",
                        );
                    }
                });
            })();
        </script>
    </head>
    <body>
        <div class="stars-bg-container" aria-hidden="true">
            <div class="stars-layer stars-1"></div>
            <div class="stars-layer stars-2"></div>
            <div class="stars-layer stars-3"></div>
        </div>

        <Navbar lang={lang} />

        <main id="main-content" class="page-enter">
            <slot />
        </main>

        <Footer lang={lang} />

        <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
                const btn = document.getElementById("menu-btn");
                const sidebar = document.querySelector(".nav-links");
                const overlay = document.getElementById("nav-overlay");

                if (btn && sidebar) {
                    btn.addEventListener("click", (e) => {
                        e.stopPropagation();
                        sidebar.classList.toggle("active");
                        btn.classList.toggle("active");
                        if (overlay) overlay.classList.toggle("active");
                        document.body.style.overflow =
                            sidebar.classList.contains("active")
                                ? "hidden"
                                : "";
                    });

                    if (overlay) {
                        overlay.addEventListener("click", () => {
                            sidebar.classList.remove("active");
                            btn.classList.remove("active");
                            overlay.classList.remove("active");
                            document.body.style.overflow = "";
                        });
                    }
                }
            });
        </script>
        <button id="scrollToTop" aria-label="Scroll to top" title="Scroll to top">
            <i class="fas fa-arrow-up"></i>
        </button>
        <script is:inline>
            (function() {
                const initScrollToTop = () => {
                    const btn = document.getElementById('scrollToTop');
                    if (!btn) return;
                    
                    window.addEventListener('scroll', () => {
                        if (window.scrollY > 300) {
                            btn.classList.add('visible');
                        } else {
                            btn.classList.remove('visible');
                        }
                    }, { passive: true });

                    btn.addEventListener('click', () => {
                        window.scrollTo({
                            top: 0,
                            behavior: 'smooth'
                        });
                    });
                };
                
                initScrollToTop();
                document.addEventListener('astro:page-load', initScrollToTop);
            })();
        </script>
    </body>
</html>
