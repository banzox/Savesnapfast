---
import { getCollection } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { languages } from '../../../i18n/ui';

export const prerender = true;

export async function getStaticPaths() {
  // Only generate paths for NON-English blog posts
  // English posts are served from /blog/[slug] (root, no lang prefix)
  const blogEntries = await getCollection('blog', ({ data }) => {
    return data.lang !== undefined && data.lang !== 'en';
  });
  
  return blogEntries.map(entry => {
    const lang = entry.data.lang;
    return {
      params: { lang, slug: entry.slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
---

<BlogPost {...entry.data} headings={headings} slug={entry.slug}>
  <Content />
</BlogPost>
